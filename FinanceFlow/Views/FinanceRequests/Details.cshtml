@model FinanceFlow.Models.FinanceRequest
@{
    var phTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Asia/Manila");
}

<h2>Finance Request Details</h2>

<dl class="row">
    <dt class="col-sm-2">Title</dt>
    <dd class="col-sm-10">@Model.Title</dd>

    <dt class="col-sm-2">Amount</dt>
    <dd class="col-sm-10">@Model.Amount.ToString("N2")</dd>

    <dt class="col-sm-2">Status</dt>
    <dd class="col-sm-10">@Model.Status</dd>
</dl>

<h4>History</h4>

<table class="table">
    <thead>
        <tr>
            <th>Date</th>
            <th>From</th>
            <th>To</th>
            <th>Action By</th>
            <th>Comment</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var history in Model.ApprovalHistories
            .OrderBy(x => x.ActionAt))
        {
            <tr>
                <td>@TimeZoneService.FormatFromUtc(@history.ActionAt)</td>
                <td>@history.FromStatus</td>
                <td>@history.ToStatus</td>
                <td>@history.ActionByUser.Email</td>
                <td>@history.Comment</td>
            </tr>
        }
    </tbody>
</table>